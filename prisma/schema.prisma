// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  clerkUserId     String           @unique
  email           String           @unique
  name            String?
  username        String?          @unique
  imageUrl        String?
  industry        String?
  industryInsight IndustryInsight? @relation(fields: [industry], references: [industry])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Profile fields
  bio        String?
  experience Int?
  skills     String[]

  assessments  Assessment[]
  resume       Resume?
  coverLetters CoverLetter[]
  portfolio    Portfolio?
  interviewSessions   InterviewSession[]
  companyIntels       CompanyIntel[]
  skillGapReports     SkillGapReport[]
  negotiationSessions NegotiationSession[]
  careerBytes         CareerByte[]
  jobApplications     JobApplication[]

  careerHealthScores  CareerHealthScore[]
  offerComparisons    OfferComparison[]
  onboardingPlans     OnboardingPlan[]
  streak              UserStreak?
}

model Assessment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizScore      Float
  questions      Json[]
  category       String
  improvementTip String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  content   String   @db.Text
  atsScore  Float?
  feedback  String?
  targetJobDescription String? @db.Text
  matchScore           Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoverLetter {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  content        String   @db.Text
  jobDescription String?
  companyName    String
  jobTitle       String
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model IndustryInsight {
  id       String @id @default(cuid())
  industry String @unique // the industry this data belongs to (e.g., "tech-software-development")

  // users in this industry
  users User[]

  // salary data
  salaryRanges Json[]

  // salary trends
  growthRate  Float
  demandLevel DemandLevel
  topSkills   String[]

  // market conditions
  marketOutlook MarketOutlook
  keyTrends     String[]

  // learning suggestions
  recommendedSkills String[]

  lastUpdated DateTime @default(now())
  nextUpdate  DateTime

  @@index([industry])
}

enum DemandLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketOutlook {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  isPublished Boolean  @default(false)
  content     String?  @db.Text
  templateId  String   @default("default")
  customUrl   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InterviewSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // "behavioral" | "technical" | "hr" | "mixed"
  targetRole      String?
  company         String?
  questions       Json[]   // [{question, userAnswer, scores, feedback, starAnalysis, improvedAnswer, toneAnalysis}]
  overallScore    Float?
  readinessScore  Float?
  strengths       String[]
  weaknesses      String[]
  improvementPlan String?  @db.Text
  rejectionRisk   String?  @db.Text
  duration        Int?
  createdAt       DateTime @default(now())
  @@index([userId])
}

model CompanyIntel {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  companyName String
  targetRole  String?
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}

model SkillGapReport {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  jobTitle        String
  company         String?
  jobDescription  String   @db.Text
  content         String   @db.Text
  readinessScore  Float?
  createdAt       DateTime @default(now())
  @@index([userId])
}

model NegotiationSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  targetRole      String
  company         String?
  expectedSalary  Float
  initialOffer    Float?
  finalSalary     Float?
  conversation    Json[]   // [{role: "recruiter"|"user", message: "..."}]
  score           Float?   // 0-100 negotiation success
  feedback        String?  @db.Text
  createdAt       DateTime @default(now())
  @@index([userId])
}

model CareerByte {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "tip" | "question" | "trend" | "motivation"
  title     String
  content   String   @db.Text
  industry  String
  date      DateTime @default(now())
  @@unique([userId, date])
  @@index([userId])
}

model JobApplication {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  company         String
  role            String
  status          String   // "APPLIED" | "INTERVIEWING" | "OFFERED" | "REJECTED"
  notes           String?  @db.Text
  nextAction      String?  // AI suggested next step
  lastFollowUp    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  onboardingPlan  OnboardingPlan?

  @@index([userId])
}

model CareerHealthScore {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score            Float    // Overall composite 0-100 score
  atsScoreWeight   Float    // Sub-score for ATS analysis (25%)
  readinessWeight  Float    // Sub-score for mock interviews (25%)
  skillGapWeight   Float    // Sub-score for skill coverage (25%)
  kanbanWeight     Float    // Sub-score for pipeline activity (25%)
  commentary       String   @db.Text // AI insight explaining primary drag factor
  createdAt        DateTime @default(now())

  @@index([userId])
}

model OfferComparison {
  id             String   @id @default(cuid())
  userId         String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers         Json     // Array of inputted offers: [{ company, role, baseSalary, equityBonus, workModel, location, growthPotential }]
  comparisonData Json     // Scored rating breakdown and reasoning recommendation from Gemini
  createdAt      DateTime @default(now())

  @@index([userId])
}

model OnboardingPlan {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplicationId String   @unique
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  role             String
  company          String
  phases           Json     // Array detailing Learn, Contribute, Lead milestones: [{ phase: "Learn", milestones: [{ id: "m1", text: "...", isCompleted: false }] }]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model UserStreak {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime @default(now())
  earnedBadges     String[] // Array of badge IDs: ["first_interview", "resume_pro", "streak_7", "apps_10", "offer_received", "negotiation_master"]
}
